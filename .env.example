# ─────────────────────────────────────────────────────────────
# SniffOrbit ONE — environment configuration
# Copy to `.env.local` for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (local, Docker, Neon, Supabase, Vercel Postgres…)
# For serverless hosting use the provider's *pooled* connection string.
DATABASE_URL=postgres://snifforbit:snifforbit@localhost:5432/snifforbit

# Separate database used by `npm test` (integration tests truncate tables!)
DATABASE_URL_TEST=postgres://snifforbit:snifforbit@localhost:5432/snifforbit_test

# Secret used to sign/derive tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Public base URL (used for canonical URLs, sitemap, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial administrator — read by `npm run db:seed` / `npm run admin:create`.
# Use a strong unique password; it is stored only as a scrypt hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Studio Admin

# ── Optional: Stripe TEST mode ───────────────────────────────
# When STRIPE_SECRET_KEY is set (must start with sk_test_), checkout redirects
# to Stripe Checkout in test mode. Without it the store runs in clearly
# labelled "test-order mode" and no payment is taken or simulated.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Protects /api/cron/expire-pending (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=replace-with-a-random-string
